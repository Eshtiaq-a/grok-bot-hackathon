# ==============================================================================
# grok-bot-hackathon environment variables
# Copy this file to .env and fill in your own sandbox/test credentials.
# NEVER commit .env or any real secret keys.
# ==============================================================================

# --- CreateOS Sandbox (required for gateway & seller) -------------------------
# Your CreateOS Sandbox API key (e.g., from Stripe Projects: `stripe projects env --pull`)
CREATEOS_SANDBOX_API_KEY=cos_sb_replace_with_your_createos_api_key
# Optional CreateOS API base URL (defaults to https://api-eu.sb.createos.sh)
CREATEOS_SANDBOX_BASE_URL=https://api-eu.sb.createos.sh

# --- Stripe Sandbox / Test Mode (required for gateway & buyer --pay test) -----
# MUST be a Stripe test-mode secret key (sk_test_... or rk_test_...). Live keys are rejected.
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret_key
# Stripe Machine Payments (MPP) profile / network ID from your Stripe test sandbox
STRIPE_PROFILE_ID=replace_with_your_stripe_profile_id
# Random secret used by mppx to sign and verify 402 payment challenges (generate e.g. `openssl rand -hex 32`)
MPP_SECRET_KEY=replace_with_random_32_byte_hex_secret

# --- Seller Agent & Attestation -----------------------------------------------
# Anthropic API key used by the seller agent to draft and fix the converter tool
ANTHROPIC_API_KEY=sk-ant-replace_with_your_anthropic_api_key
# Optional model overrides for drafting and fixing
ANTHROPIC_MODEL=claude-sonnet-5-5
SELLER_FIX_MODEL=claude-sonnet-5-5
# Base64-encoded PKCS8 Ed25519 private key PEM used to sign seller offer manifests.
# Generate with:
#   openssl genpkey -algorithm ed25519 | base64 | tr -d '\n'
SELLER_SIGNING_KEY=replace_with_base64_pkcs8_ed25519_pem

# --- Gateway & Demo Configuration ---------------------------------------------
# Public or local URL of the gateway (used by buyer, seller, and OpenAPI/llms.txt discovery)
POLYGRAPH_GATEWAY_URL=http://localhost:4242
# Port the gateway listens on (default: 4242)
PORT=4242
# Set to 1 if running behind a TLS reverse proxy (reads X-Forwarded-* headers)
TRUST_PROXY=0
# Set to 1 to list demo foil offers alongside genuine offers (for demonstrating tamper detection)
DEMO_FOILS=1
# Set to 1 to enable POST /demo/tamper ("Tamper it yourself" buttons on the live console)
DEMO_TAMPER=1

# --- Optional Auth Tokens & Pool Tuning ---------------------------------------
# Optional shared secrets protecting runtime offer publishing and event ingestion
PUBLISH_TOKEN=
EVENTS_TOKEN=
# Number of pre-forked warm workers per offer (default: 1; set 0 to fork on demand)
POOL_SIZE=1
# Optional comma-separated offer IDs to keep warm pools for (empty = all offers)
POOL_OFFERS=
# Account-wide orphan worker sweep: 1 (on), 0 (off), or dry (log only). Defaults to off locally, on in production.
ORPHAN_SWEEP=0
# Purchase and fork timeout tuning (seconds)
PURCHASE_TTL_SECONDS=900
UNUSED_REFUND_SECONDS=300
BUY_FORK_DEADLINE_SECONDS=45

# --- Buyer Own-Account Mode (optional, for `npm run buyer -- --mode own`) -----
# Separate CreateOS account API key for executing verified bundles in the buyer's own sandbox
BUYER_CREATEOS_SANDBOX_API_KEY=
CREATEOS_PLAN_API_KEY=

# --- Deployment (optional, used by scripts/deploy.sh) -------------------------
CREATEOS_PROJECT_ID=
CREATEOS_ENVIRONMENT_ID=
CREATEOS_PROJECT_API_KEY=
